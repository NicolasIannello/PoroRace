<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionDef ParentName="FactionBase" Abstract="True" Name="PorosBase">
		<pawnSingular>poro</pawnSingular>
		<pawnsPlural>poros</pawnsPlural>
		<categoryTag>Poro</categoryTag>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<configurationListOrderPriority>2000</configurationListOrderPriority>
		<displayInFactionSelection>true</displayInFactionSelection>
		<fixedName>Poros</fixedName>
		<canGenerateQuestSites>false</canGenerateQuestSites>
		<techLevel>Industrial</techLevel>
		<backstoryFilters>
			<li>
				<categories>
					<li>Offworld</li>
					<li>Outlander</li>
				</categories>
			</li>
		</backstoryFilters>
		<rescueesCanJoin>true</rescueesCanJoin>
		<autoFlee>false</autoFlee>
		<apparelStuffFilter>
			<thingDefs>
				<li>Synthread</li>
				<li>Hyperweave</li>
				<li>Plasteel</li>
				<li>DevilstrandCloth</li>
				<li>Uranium</li>
				<li>Steel</li>
				<li>Cloth</li>
			</thingDefs>
		</apparelStuffFilter>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<raidsForbidden>false</raidsForbidden>
		<raidCommonalityFromPointsCurve>
			<points>
				<li>(0, 0)</li>
				<li>(400, 1)</li>
			</points>
		</raidCommonalityFromPointsCurve>
		<messageDefendersAttacking>Poros are attacking.</messageDefendersAttacking>
		<xenotypeSet Inherit="False">
			<xenotypeChances>
				<Poro_XenoType>999</Poro_XenoType>
			</xenotypeChances>
		</xenotypeSet>
		<structureMemeWeights>
			<Structure_Animist MayRequire="Ludeon.RimWorld.Ideology">4</Structure_Animist>
		</structureMemeWeights>
		<arrivalModeWhitelist>
			<li>EdgeWalkIn</li>
		</arrivalModeWhitelist>
	</FactionDef>

	<FactionDef ParentName="PorosBase">
		<defName>WanderingPoros</defName>
		<label>wandering poros</label>
		<leaderTitle>poro king</leaderTitle>
		<hidden>false</hidden>
		<!--<classicIdeo>true</classicIdeo>-->
		<fixedLeaderKinds>
			<li>KingPoro</li>
		</fixedLeaderKinds>
		<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>10</configurationListOrderPriority>
		<factionIconPath>Xenotypes/WanderingPoroIcon</factionIconPath>
		<settlementTexturePath>Xenotypes/WanderingPoroIcon</settlementTexturePath>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<factionNameMaker>NamerFactionTribal</factionNameMaker>
		<settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
		<allowedCultures><li>Corunan</li></allowedCultures>
		<structureMemeWeights>
			<Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginBuddhist>
		</structureMemeWeights>
		<allowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
		</allowedMemes>
		<requiredMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
		</requiredMemes>
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<options>
					<GuardPoro>1</GuardPoro>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<WanderingPoro>1</WanderingPoro>
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<TraderPoro>1</TraderPoro>
				</traders>
				<carriers>
					<Muffalo>5</Muffalo>
					<!--<Bison>3</Bison>
					<Yak>2</Yak>
					<Mastodon MayRequire="Ludeon.RimWorld.Odyssey">3</Mastodon>-->
				</carriers>
				<guards>
					<WanderingPoro>5</WanderingPoro>
					<GuardPoro>10</GuardPoro>
				</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<GuardPoro>30</GuardPoro>
				</options>
			</li>
		</pawnGroupMakers>
		<caravanTraderKinds>
			<li>Caravan_Poro</li>
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Caravan_Poro</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>Caravan_Poro</li>
		</baseTraderKinds>
	</FactionDef>

	<FactionDef ParentName="PorosBase">
		<defName>PlunderingPoros</defName>
		<label>plundering poros</label>
		<hidden>true</hidden>
		<factionIconPath>Xenotypes/PlunderingPoroIcon</factionIconPath>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<allowedCultures><li>Kriminul</li></allowedCultures>
		<allowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
		</allowedMemes>
		<requiredMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
		</requiredMemes>
		<permanentEnemy>true</permanentEnemy>
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<options>
					<PlunderingPoro>1</PlunderingPoro>
				</options>
			</li>
		</pawnGroupMakers>
	</FactionDef>
</Defs>