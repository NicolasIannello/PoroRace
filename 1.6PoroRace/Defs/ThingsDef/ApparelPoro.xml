	<ThingCategoryDef>
		<defName>Poro_Category_Armor</defName>
		<label>Poro armor</label>
		<!--<parent>ApparelArmor</parent>-->
		<parent>Poro_Category_Apparel</parent>
	</ThingCategoryDef>

	<ThingCategoryDef>
		<defName>Poro_Category_Apparel</defName>
		<label>Poro apparel</label>
		<parent>Apparel</parent>
	</ThingCategoryDef>
	
	<ThingDef ParentName="ArmorMachineableBase">
		<defName>Poro_Bucket_Armor</defName>
		<label>Poro bucket armor</label>
		<description>A heavy, protective bucket of armor forged from metal.</description>
		<possessionCount>1</possessionCount>
		<techLevel>Medieval</techLevel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<researchPrerequisite>PlateArmor</researchPrerequisite>
			<recipeUsers>
				<li>ElectricSmithy</li>
				<li>FueledSmithy</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<defaultIngredientFilter>
				<stuffCategoriesToAllow>
					<li>Metallic</li>
				</stuffCategoriesToAllow>
			</defaultIngredientFilter>
		</recipeMaker>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>40</costStuffCount>
		<graphicData>
			<texPath>Apparel/Poro_Bucket/Poro_Bucket</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>2000</WorkToMake>
			<MaxHitPoints>250</MaxHitPoints>
			<Mass>12</Mass>
			<ArmorRating_Sharp>0.60</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Heat>0.30</ArmorRating_Heat>
			<EquipDelay>1</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.40</MoveSpeed>
		</equippedStatOffsets>
		<thingCategories>
			<li>Poro_Category_Armor</li>
		</thingCategories>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/Poro_Bucket/Poro_Bucket</wornGraphicPath>
			<layers>
				<li>Shell</li>
			</layers>
			<drawData>
				<defaultData>
					<layer>59</layer>
				</defaultData>
			</drawData>
			<tags>
				<li>PoroArmor</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>PoroArmor</li>
		</tradeTags>
	</ThingDef>

	<ThingDef ParentName="ApparelMakeableBase">
		<defName>Poro_Duster</defName>
		<description>A long duster coat for blocking the sun and grit of the outdoors for poros.</description>
		<label>poro duster</label>
		<techLevel>Medieval</techLevel>
		<possessionCount>1</possessionCount>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
			<displayPriority>215</displayPriority>
		</recipeMaker>
		<graphicData>
			<texPath>Apparel/Poro_Duster/Poro_Duster</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<thingCategories>
			<li>Poro_Category_Apparel</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>5000</WorkToMake>
			<Mass>2</Mass>
			<StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.85</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.05</SlaveSuppressionOffset>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Apparel/Poro_Duster/Poro_Duster</wornGraphicPath>
			<layers>
				<li>Middle</li>
			</layers>
			<drawData>
				<defaultData>
					<layer>55</layer>
				</defaultData>
			</drawData>
			<tags>
				<li>PoroApparel</li>
			</tags>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>PoroApparel</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65)</only>
				</li>
				<li>
					<weight>30</weight>
					<only>(0.4,0.3,0.15)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3)</min>
					<max>(0.5,0.5,0.5)</max>
				</li>
				<li>
					<weight>2</weight>
					<min>(0.5,0.5,0.5)</min>
					<max>(1,1,1)</max>
				</li>
			</options>
		</colorGenerator>
	</ThingDef>

</Defs>