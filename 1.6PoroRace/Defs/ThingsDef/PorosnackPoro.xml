		</ingredients>
		<products>
			<Poro_Porosnack>1</Poro_Porosnack>
		</products>
		<fixedIngredientFilter>
			<thingDefs><li>Luciferium</li></thingDefs>
			<thingDefs><li>Chocolate</li></thingDefs>
			<thingDefs><li>Hay</li></thingDefs>
		</fixedIngredientFilter>
