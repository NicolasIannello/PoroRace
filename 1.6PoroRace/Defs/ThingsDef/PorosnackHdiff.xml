<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>Porosnack_Hediff</defName>
		<label>Porosnax buildup</label>
		<description>Poro has eaten a porosnax.</description>
		<hediffClass>PoroRace.Things.Hediff_Porosnack</hediffClass>
		<maxSeverity>1.0</maxSeverity>
		<initialSeverity>0</initialSeverity>
		<defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
		<isBad>false</isBad>
		<stages>
			<li>
				<label>empty</label>
				<minSeverity>0.0</minSeverity>
			</li>
			<li>
				<label>moderate</label>
				<minSeverity>0.5</minSeverity>
		</li>
			<li>
				<label>full</label>
				<minSeverity>1.0</minSeverity>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.2</severityPerDay>
				<showHoursToRecover>false</showHoursToRecover>
			</li>
		</comps>
	</HediffDef>
	
	<HediffDef>
		<defName>PorosnackRecovery_Hediff</defName>
		<label>Porosnax recovery</label>
		<description>recovering from too much porosnaxs.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<maxSeverity>1.0</maxSeverity>
		<initialSeverity>1.0</initialSeverity>
		<defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.1</severityPerDay>
				<showDaysToRecover>true</showDaysToRecover>
			</li>
		</comps>
	</HediffDef>

</Defs>